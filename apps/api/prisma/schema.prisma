generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Character {
  id           String    @id @default(cuid())
  battleNetId  String?
  name         String
  realm        String
  realmSlug    String?
  region       String    @default("eu")
  className    String
  level        Int       @default(80)
  source       String    @default("MANUAL")
  lastSyncedAt DateTime?
  /*
   * Canonical SynTrack account that owns this character. Nullable for
   * pre-ownership rows and non-device (web/manual) creates until an
   * owned DeviceCredential import proves association. One character
   * maps to at most one RaiderAccount; never guessed from BattleTag.
   */
  raiderAccountId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  raiderAccount RaiderAccount? @relation(fields: [raiderAccountId], references: [id], onDelete: SetNull)

  professions       CharacterProfession[]
  weeklyCompletions WeeklyChecklistCompletion[]
  weeklyMythicRuns  WeeklyMythicPlusRun[]
  personalRaidTasks PersonalRaidTask[]
  gearSlots         CharacterGearSlot[]
  gearBagSetPieces CharacterGearBagSetPiece[]
  trackerValues     CharacterTrackerValue[]
  tagAssignments    CharacterTagAssignment[]
  resourceSnapshots CharacterResourceSnapshot[]
  professionWeeklySnapshots CharacterProfessionWeeklySnapshot[]
  professionKnowledgeTreasureSnapshots CharacterProfessionKnowledgeTreasureSnapshot[]
  weeklyGameplaySnapshots CharacterWeeklyGameplaySnapshot[]

  @@unique([name, realm, region])
  @@index([battleNetId, region])
  @@index([source])
  @@index([raiderAccountId])
}

model CharacterTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments CharacterTagAssignment[]
}

model CharacterTagAssignment {
  id          String   @id @default(cuid())
  characterId String
  tagId       String
  createdAt   DateTime @default(now())

  character Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tag       CharacterTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([characterId, tagId])
  @@index([tagId])
}

model WeeklyChecklistTask {
  id          String  @id @default(cuid())
  key         String  @unique
  title       String
  description String
  category    String
  sortOrder   Int     @default(0)
  enabled     Boolean @default(true)

  completions WeeklyChecklistCompletion[]
}

model WeeklyChecklistCompletion {
  id          String   @id @default(cuid())
  characterId String
  taskId      String
  periodKey   String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  task      WeeklyChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([characterId, taskId, periodKey])
  @@index([periodKey])
  @@index([taskId, periodKey])
}

model WeeklyMythicPlusRun {
  id          String   @id @default(cuid())
  characterId String
  periodKey   String
  dungeonName String?
  keyLevel    Int
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, periodKey])
  @@index([periodKey, keyLevel])
}

model PersonalRaidTask {
  id          String    @id @default(cuid())
  characterId String
  title       String
  description String?
  category    String    @default("PREPARATION")
  priority    String    @default("NORMAL")
  raidName    String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, completedAt])
  @@index([dueAt])
}

model CharacterGearSlot {
  id                   String    @id @default(cuid())
  characterId          String
  slotKey              String
  itemId               Int?
  itemLink             String?
  itemName             String?
  itemLevel            Int?
  quality              Int?
  enchantStatus        String    @default("NOT_APPLICABLE")
  enchantName          String?
  enchantId            Int?
  socketCount          Int?
  gemCount             Int       @default(0)
  gemIds               String?
  notes                String?
  source               String    @default("MANUAL")
  lastSyncedAt         DateTime?
  /*
   * Tier-set / embellishment evidence from Gear schemaVersion 2.
   * Raw facts only - never derived "isTier"/"isEmbellished" booleans.
   * setBonusSpellIds is a JSON number array when setBonusResolved.
   */
  setId                Int?
  expansionId          Int?
  setEvidenceResolved  Boolean?
  setBonusResolved     Boolean?
  setBonusSpellIds     String?
  uniqueCategoryId     Int?
  uniqueCategoryCount  Int?
  uniquenessResolved   Boolean?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, slotKey])
  @@index([slotKey])
  @@index([source])
}

model CharacterGearBagSetPiece {
  id                   String    @id @default(cuid())
  characterId          String
  itemId               Int?
  itemLink             String?
  setId                Int?
  expansionId          Int?
  equipLoc             String?
  setEvidenceResolved  Boolean?
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, setId])
  @@index([characterId])
}

enum ResourceCategory {
  UPGRADE
  CRAFTING_GATE
  CONVERSION
  OTHER
}

enum ResourceOwnershipScope {
  CHARACTER
  ACCOUNT_WIDE
  UNKNOWN
}

/*
 * A tracked resource's stable identity/config - season-scoped via scopeKey
 * (a TrackerScopeProfile.key, or the reserved GLOBAL sentinel), never a
 * second independent "active season" mechanism. externalCurrencyId and
 * externalItemId are both nullable because a definition is backed by
 * exactly one of the two capture strategies (a plain WoW currency, or an
 * item-count-based resource like Spark of Tides) - at least one must be
 * set for any definition that is meant to be captured automatically.
 * Each unique index only actually constrains rows where that particular
 * external id is non-null (SQLite treats NULL as distinct per row), so
 * currency-backed and item-backed definitions never collide with each
 * other through the "wrong" index.
 */
model ResourceDefinition {
  id                 String                 @id @default(cuid())
  key                String                 @unique
  scopeKey           String
  externalCurrencyId Int?
  externalItemId     Int?
  name               String
  category           ResourceCategory
  resetBehavior      TrackerResetBehavior
  ownershipScope     ResourceOwnershipScope @default(UNKNOWN)
  enabled            Boolean                @default(true)
  sortOrder          Int                    @default(0)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  snapshots CharacterResourceSnapshot[]

  @@unique([scopeKey, externalCurrencyId])
  @@unique([scopeKey, externalItemId])
  @@index([scopeKey])
  @@index([enabled])
}

/*
 * Latest-state-only (V1 has no historical ledger - see the Currency &
 * Weekly Resource Tracking audit). Every authoritative numeric field is
 * nullable because the WoW API can legitimately provide no evidence for
 * it (an undiscovered currency, a cap concept that doesn't apply, a
 * failed Catalyst read) - a null here must never be read as zero.
 * accountWide is the raw per-capture ownership evidence Blizzard
 * reported for this specific snapshot, kept separate from
 * ResourceDefinition.ownershipScope (the configured product scope) so a
 * conflict between the two can be detected conservatively instead of one
 * silently overriding the other (see resource-readiness's account-wide
 * aggregation).
 */
model CharacterResourceSnapshot {
  id                   String   @id @default(cuid())
  characterId          String
  resourceDefinitionId String

  quantity          Int?
  maxQuantity       Int?
  weeklyQuantity    Int?
  maxWeeklyQuantity Int?
  isCapped          Boolean?
  isWeeklyCapped    Boolean?
  discovered        Boolean?
  accountWide       Boolean?

  source     String   @default("ADDON")
  capturedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  character          Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  resourceDefinition ResourceDefinition @relation(fields: [resourceDefinitionId], references: [id], onDelete: Cascade)

  @@unique([characterId, resourceDefinitionId])
  @@index([resourceDefinitionId])
}

enum ProfessionWeeklySourceType {
  WEEKLY_QUEST
  TREATISE
  KNOWLEDGE_DROPS
}

enum ProfessionWeeklyState {
  COMPLETE
  INCOMPLETE
  UNKNOWN
}

/*
 * A profession's weekly-completion source identity, season-scoped via
 * scopeKey exactly like ResourceDefinition (a TrackerScopeProfile.key,
 * or the reserved GLOBAL sentinel) - never a second "active season"
 * mechanism. enabled defaults to false: per the Automatic Profession
 * Weekly audit, exact quest IDs are community-sourced, not Blizzard-
 * documented, so a definition must be deliberately verified live
 * before it can affect what a user sees - inventing an id and
 * defaulting it to enabled would be exactly the "guessed truth" this
 * product forbids. PROF KP is derived only from WEEKLY_QUEST/TREATISE
 * sources; KNOWLEDGE_DROPS is tracked but never folds into that
 * aggregate (see ProfessionWeeklyStatusService).
 */
model ProfessionWeeklySourceDefinition {
  id                 String                     @id @default(cuid())
  scopeKey           String
  professionKey      String
  sourceKey          String
  name               String
  sourceType         ProfessionWeeklySourceType
  externalQuestId    Int?
  externalCurrencyId Int?
  enabled            Boolean                    @default(false)
  sortOrder          Int                        @default(0)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt

  snapshots CharacterProfessionWeeklySnapshot[]

  @@unique([scopeKey, professionKey, sourceKey])
  @@index([scopeKey])
  @@index([enabled])
}

/*
 * One row per character/source/weekly-period - never overwritten across
 * a reset (unlike CharacterResourceSnapshot's latest-state-only shape),
 * so a stale prior week can never be misread as current (see Section 23
 * of the audit). Raw evidence (flaggedCompleted/externalQuestId for
 * quest-flag sources, current/maxValue for the Knowledge Drops
 * aggregate) is stored alongside the derived `state` so the backend
 * read model never has to re-derive UI status from Lua-computed labels.
 */
model CharacterProfessionWeeklySnapshot {
  id                 String @id @default(cuid())
  characterId        String
  sourceDefinitionId String
  periodKey          String

  state ProfessionWeeklyState

  flaggedCompleted Boolean?
  externalQuestId  Int?
  currentValue     Int?
  maxValue         Int?

  source     String   @default("ADDON")
  capturedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  character        Character                        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  sourceDefinition ProfessionWeeklySourceDefinition @relation(fields: [sourceDefinitionId], references: [id], onDelete: Cascade)

  @@unique([characterId, sourceDefinitionId, periodKey])
  @@index([sourceDefinitionId])
  @@index([periodKey])
}

model CharacterWeeklyGameplaySnapshot {
  id          String   @id @default(cuid())
  characterId String
  periodKey   String
  capturedAt  DateTime
  source      String   @default("ADDON")

  vaultCaptured      Boolean
  vaultGenerated     Boolean?
  vaultCurrentPeriod Boolean?
  vaultCanClaim      Boolean?
  vaultHasAvailable  Boolean?

  mythicPlusCaptured Boolean
  raidCaptured       Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  character  Character                        @relation(fields: [characterId], references: [id], onDelete: Cascade)
  vaultActivities CharacterWeeklyVaultActivity[]
  mythicPlusRuns  CharacterWeeklyMythicPlusCapture[]
  raidLockouts    CharacterWeeklyRaidLockout[]

  @@unique([characterId, periodKey])
  @@index([periodKey])
}

model CharacterWeeklyVaultActivity {
  id         String @id @default(cuid())
  snapshotId String

  type           Int
  typeName       String?
  index          Int?
  threshold      Int?
  progress       Int?
  activityId     Int?
  level          Int?
  activityTierId Int?
  claimId        Int?

  snapshot CharacterWeeklyGameplaySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId, type])
}

model CharacterWeeklyMythicPlusCapture {
  id         String @id @default(cuid())
  snapshotId String

  mapChallengeModeId Int?
  keyLevel           Int
  completed          Boolean?
  thisWeek           Boolean?
  durationSec        Int?
  dungeonScore       Int?

  snapshot CharacterWeeklyGameplaySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
}

model CharacterWeeklyRaidLockout {
  id         String @id @default(cuid())
  snapshotId String

  instanceName       String
  difficulty         Int?
  difficultyName     String?
  encounterProgress  Int?
  numEncounters      Int?
  encountersJson     String

  snapshot CharacterWeeklyGameplaySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([snapshotId])
}

enum ProfessionKnowledgeTreasureState {
  COMPLETE
  INCOMPLETE
  UNKNOWN
}

/*
 * A permanent, once-per-character-per-profession Knowledge source
 * (e.g. a world-collectible item) - fully separate from
 * ProfessionWeeklySourceDefinition, which resets every week. See the
 * profession weekly correctness follow-up's Knowledge Treasures
 * addition. Deliberately its own model rather than folded into the
 * weekly one: reusing getWeeklyPeriod()-keyed rows for something that
 * never resets would make "is this still current" ambiguous.
 */
model ProfessionKnowledgeTreasureDefinition {
  id              String   @id @default(cuid())
  scopeKey        String
  professionKey   String
  sourceKey       String
  name            String
  externalQuestId Int
  knowledgePoints Int?
  enabled         Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  snapshots CharacterProfessionKnowledgeTreasureSnapshot[]

  @@unique([scopeKey, professionKey, sourceKey])
  @@index([scopeKey])
  @@index([enabled])
}

/*
 * One row per character/definition, permanent - no weekly period key.
 * Once state is COMPLETE it is never overwritten back to UNKNOWN or
 * INCOMPLETE by a later capture (see the persistence layer's monotonic
 * upsert) - a one-time quest flag genuinely completed can't become
 * un-completed, so a later failed/unresolved lookup must never regress
 * already-proven permanent truth.
 */
model CharacterProfessionKnowledgeTreasureSnapshot {
  id           String @id @default(cuid())
  characterId  String
  definitionId String

  state ProfessionKnowledgeTreasureState

  flaggedCompleted Boolean?
  externalQuestId  Int?

  source     String   @default("ADDON")
  capturedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  character  Character                            @relation(fields: [characterId], references: [id], onDelete: Cascade)
  definition ProfessionKnowledgeTreasureDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([characterId, definitionId])
  @@index([definitionId])
}

model TrackerScopeProfile {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  isActive  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TrackerValueType {
  BOOLEAN
  PROGRESS
  NUMBER
  TEXT
}

enum TrackerResetBehavior {
  WEEKLY
  SEASONAL
  PERMANENT
}

model CharacterTrackerDefinition {
  id            String               @id @default(cuid())
  scopeKey      String
  key           String
  name          String
  valueType     TrackerValueType
  resetBehavior TrackerResetBehavior
  category      String?
  sortOrder     Int                  @default(0)
  isPinned      Boolean              @default(true)
  enabled       Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  values CharacterTrackerValue[]

  @@unique([scopeKey, key])
  @@index([scopeKey])
  @@index([enabled, isPinned])
}

model CharacterTrackerValue {
  id                  String   @id @default(cuid())
  trackerDefinitionId String
  characterId         String
  periodKey           String

  booleanValue    Boolean?
  progressCurrent Int?
  progressTotal   Int?
  numberValue     Int?
  textValue       String?

  source    String   @default("MANUAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackerDefinition CharacterTrackerDefinition @relation(fields: [trackerDefinitionId], references: [id], onDelete: Cascade)
  character         Character                  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([trackerDefinitionId, characterId, periodKey])
  @@index([characterId])
  @@index([periodKey])
}

model Profession {
  id       String @id @default(cuid())
  key      String @unique
  name     String
  category String
  order    Int    @default(0)

  assignments         CharacterProfession[]
  specializationTrees ProfessionSpecializationTree[]
  capabilities        CraftCapability[]
  recipes             CraftRecipe[]
}

model CharacterProfession {
  id                    String  @id @default(cuid())
  characterId           String
  professionId          String
  skill                 Int     @default(0)
  skillModifier         Int     @default(0)
  knowledgePoints       Int     @default(0)
  specializationSummary String?

  character  Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  profession Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  nodeProgress CharacterProfessionNodeProgress[]
  recipes      CharacterCraftRecipe[]

  @@unique([characterId, professionId])
  @@index([professionId])
}

model ProfessionSpecializationTree {
  id           String  @id @default(cuid())
  professionId String
  expansion    String  @default("MIDNIGHT")
  key          String
  name         String
  description  String?
  sortOrder    Int     @default(0)

  profession Profession                     @relation(fields: [professionId], references: [id], onDelete: Cascade)
  nodes      ProfessionSpecializationNode[]

  @@unique([professionId, expansion, key])
  @@index([professionId, expansion])
}

model ProfessionSpecializationNode {
  id               String  @id @default(cuid())
  treeId           String
  parentNodeId     String?
  key              String
  name             String
  description      String?
  maxRank          Int?
  knowledgeMaxRank Int?
  spellId          Int?
  iconUrl          String?
  sortOrder        Int     @default(0)

  tree     ProfessionSpecializationTree      @relation(fields: [treeId], references: [id], onDelete: Cascade)
  parent   ProfessionSpecializationNode?     @relation("SpecializationNodeHierarchy", fields: [parentNodeId], references: [id], onDelete: SetNull)
  children ProfessionSpecializationNode[]    @relation("SpecializationNodeHierarchy")
  progress CharacterProfessionNodeProgress[]

  @@unique([treeId, key])
  @@index([treeId, parentNodeId])
}

model CharacterProfessionNodeProgress {
  id                    String    @id @default(cuid())
  characterProfessionId String
  nodeId                String
  rank                  Int       @default(1)
  knowledgeRank         Int?
  unlockRank            Int?
  source                String    @default("MANUAL")
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  characterProfession CharacterProfession          @relation(fields: [characterProfessionId], references: [id], onDelete: Cascade)
  node                ProfessionSpecializationNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([characterProfessionId, nodeId])
  @@index([nodeId])
  @@index([source])
}

model CraftCapability {
  id           String  @id @default(cuid())
  professionId String
  expansion    String  @default("MIDNIGHT")
  key          String
  name         String
  type         String
  slotKey      String?
  description  String?
  sortOrder    Int     @default(0)

  profession Profession              @relation(fields: [professionId], references: [id], onDelete: Cascade)
  recipes    CraftRecipeCapability[]

  @@unique([professionId, expansion, key])
  @@index([professionId, expansion])
  @@index([professionId, expansion, type])
}

model CraftRecipe {
  id                   String    @id @default(cuid())
  professionId         String
  gameRecipeId         Int
  skillLineId          Int?
  expansion            String    @default("MIDNIGHT")
  name                 String
  categoryId           Int?
  craftedItemId        Int?
  iconUrl              String?
  itemQuality          String?
  itemLevel            Int?
  baseDifficulty       Int?
  operationMetricsJson String?
  reagentSchemaJson    String?
  source               String    @default("ADDON")
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profession   Profession              @relation(fields: [professionId], references: [id], onDelete: Cascade)
  capabilities CraftRecipeCapability[]
  characters   CharacterCraftRecipe[]

  @@unique([professionId, gameRecipeId])
  @@index([professionId, expansion])
  @@index([gameRecipeId])
  @@index([craftedItemId])
}

model CraftRecipeCapability {
  craftRecipeId String
  capabilityId  String
  isPrimary     Boolean @default(false)

  recipe     CraftRecipe     @relation(fields: [craftRecipeId], references: [id], onDelete: Cascade)
  capability CraftCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([craftRecipeId, capabilityId])
  @@index([capabilityId])
}

model CharacterCraftRecipe {
  id                          String    @id @default(cuid())
  characterProfessionId       String
  craftRecipeId               String
  learned                     Boolean   @default(true)
  baseSkill                   Int?
  bonusSkill                  Int?
  effectiveSkill              Int?
  craftingQuality             Int?
  craftingQualityId           Int?
  guaranteedCraftingQualityId Int?
  lowerSkillThreshold         Int?
  upperSkillThreshold         Int?
  concentrationCost           Int?
  concentrationCurrencyId     Int?
  ingenuityRefund             Int?
  quality                     Float?
  operationMetricsJson        String?
  reagentSimulationJson       String?
  operationCapturedAt         DateTime?
  operationCaptureVersion     Int?
  operationScopeVersion       Int?
  source                      String    @default("ADDON")
  lastSyncedAt                DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  characterProfession CharacterProfession @relation(fields: [characterProfessionId], references: [id], onDelete: Cascade)
  recipe              CraftRecipe         @relation(fields: [craftRecipeId], references: [id], onDelete: Cascade)

  @@unique([characterProfessionId, craftRecipeId])
  @@index([craftRecipeId])
  @@index([source])
  @@index([operationCaptureVersion])
}

model GuildMember {
  id           String    @id @default(cuid())
  name         String
  realm        String
  region       String    @default("eu")
  className    String
  level        Int       @default(80)
  rank         String
  rankIndex    Int       @default(0)
  role         String?
  note         String?
  officerNote  String?
  source       String    @default("MANUAL")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  averageItemLevel    Float?
  missingEnchantSlots Int?
  totalSocketCount    Int?
  filledSocketCount   Int?
  auditedAt           DateTime?

  linkedRaiderAccountId String? @unique

  teamMemberships GuildTeamMembership[]
  officerNotes    GuildOfficerNote[]
  gearSlots       GuildMemberGearSlot[]

  @@unique([name, realm, region])
  @@index([rankIndex])
  @@index([source])
}

model GuildMemberGearSlot {
  id                String   @id @default(cuid())
  memberId          String
  slotKey           String
  itemName          String?
  itemLevel         Int?
  quality           String?
  enchantStatus     String   @default("NOT_APPLICABLE")
  socketCount       Int      @default(0)
  filledSocketCount Int      @default(0)
  upgradeCurrent    Int?
  upgradeMax        Int?
  updatedAt         DateTime @updatedAt

  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, slotKey])
  @@index([memberId])
}

model GuildOfficerNote {
  id              String   @id @default(cuid())
  memberId        String
  authorCharacter String
  body            String
  createdAt       DateTime @default(now())

  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model GuildTeam {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GuildTeamMembership[]
}

model GuildTeamMembership {
  id       String   @id @default(cuid())
  teamId   String
  memberId String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  team   GuildTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([memberId])
}

model GuildRequirement {
  id               String   @id @default(cuid())
  title            String
  description      String?
  category         String   @default("OTHER")
  minimumItemLevel Int?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model LootTierPreference {
  id        String   @id @default(cuid())
  memberId  String
  tierSlot  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, tierSlot])
  @@index([memberId])
}

model LootTrinketChoice {
  id        String   @id @default(cuid())
  memberId  String
  rank      Int
  itemId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, rank])
  @@index([memberId])
}

model LootSimReport {
  id           String   @id @default(cuid())
  memberId     String   @unique
  reportId     String
  reportUrl    String
  publicTitle  String
  charClass    String
  spec         String
  baselineDps  Float
  upgradesJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GuildVerification {
  id                  String   @id
  guildName           String
  realmName           String
  realmSlug           String
  region              String
  faction             String?
  memberCount         Int?
  verifiedCharacter   String
  verifiedRealmSlug   String
  verifiedRank        Int
  leadershipThreshold Int      @default(2)
  verifiedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// deviceLinkRequestId is a server-verified reference to a pending codeless
// desktop connection (see DeviceLinkRequest below) - it is only ever set
// after the /connect handler independently validated the raw browser
// capability the client supplied against a real, unexpired, unbound
// DeviceLinkRequest row. From this point on the callback trusts only this
// server-stored id, never re-reading any client-supplied identifier, the
// same principle already applied to intent/returnTo.
model BattleNetOAuthState {
  id                  String   @id
  intent              String   @default("login")
  returnTo            String?
  deviceLinkRequestId String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@index([expiresAt])
}

// battleNetAccountId is the canonical, stable identity Blizzard returns
// on every OAuth userinfo response (its "id"/"sub" claim) - this is the
// uniqueness/lookup key. battleTag is only a synced-on-login display
// field: BattleTags are mutable (a player can change theirs), so it is
// intentionally NOT unique at the DB level - see raider-auth.repository.ts
// for how legacy rows (created before this column existed) get backfilled.
model RaiderAccount {
  id                 String    @id @default(cuid())
  battleNetAccountId String?   @unique
  battleTag          String?
  accessToken        String?
  tokenType          String?
  scope              String?
  tokenExpiresAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  sessions           RaiderSession[]
  deviceLinkRequests DeviceLinkRequest[]
  deviceCredentials  DeviceCredential[]
  characters         Character[]
  removedCharacters  RemovedCharacter[]

  @@index([battleTag])
}

/*
 * Account-scoped suppression for characters intentionally removed from
 * SynTrack. Automatic addon/desktop/Battle.net import must skip matching
 * identities until the user restores. Does not store a full Character copy.
 */
model RemovedCharacter {
  id                   String   @id @default(cuid())
  raiderAccountId      String
  stableCharacterKey   String
  characterName        String
  realmName            String
  region               String   @default("eu")
  battleNetId          String?
  removedAt            DateTime @default(now())

  raiderAccount RaiderAccount @relation(fields: [raiderAccountId], references: [id], onDelete: Cascade)

  @@unique([raiderAccountId, stableCharacterKey])
  @@index([raiderAccountId, battleNetId])
}

// A short-lived, single-use record bridging "Battle.net OAuth succeeded"
// and "the user explicitly clicked Create account" (raider-auth.service
// RaiderAuthService.confirmRegistration). No RaiderAccount is ever
// created off the back of OAuth success alone - only consuming this row
// via the confirm endpoint creates one. Mirrors the spirit of
// DeviceLinkRequest's PENDING -> CONSUMED shape, scoped down to what
// registration confirmation actually needs.
model RaiderPendingRegistration {
  id                  String   @id
  battleNetAccountId  String
  battleTag           String?
  accessToken         String
  tokenType           String
  scope               String?
  tokenExpiresAt      DateTime
  charactersJson      String
  // Carried through from the BattleNetOAuthState row that produced this
  // pending registration, so a device-connect journey survives the full
  // OAuth -> explicit "Create account" round trip (see
  // RaiderAuthCallbackService.confirmRegistration) without a client-
  // supplied query param ever being trusted a second time.
  returnTo            String?
  deviceLinkRequestId String?
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@index([expiresAt])
}

model RaiderSession {
  id              String   @id
  raiderAccountId String
  charactersJson  String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  account RaiderAccount @relation(fields: [raiderAccountId], references: [id], onDelete: Cascade)

  @@index([raiderAccountId])
}

enum DeviceLinkStatus {
  PENDING
  APPROVED
  CONSUMED
  EXPIRED
}

// userCode/deviceCodeHash back the legacy human-typed manual-code flow
// (kept for Advanced/diagnostic use only). browserTokenHash backs the
// codeless flow: a high-entropy, single-use, short-lived secret that is
// safe to put in a URL - opening it plus being authenticated in that
// browser is itself the authorization, so no separate userCode/approval
// step is required for a normal connection. Exactly one of
// userCode/browserTokenHash is set per row, matching which flow created
// it; deviceCodeHash (the client-only polling secret) is always set and
// is intentionally never derivable from browserTokenHash - see
// device-auth.crypto.ts. raiderAccountId is a plain, unenforced reference
// (mirrors GuildMember.linkedRaiderAccountId) recording which account
// authorized this connection - set once, at PENDING -> APPROVED time, and
// never overwritten by a later bind attempt from a different account (see
// DeviceLinkService.bindConnection/bindConnectionInternal).
model DeviceLinkRequest {
  id               String           @id @default(cuid())
  userCode         String?          @unique
  deviceCodeHash   String           @unique
  browserTokenHash String?          @unique
  status           DeviceLinkStatus @default(PENDING)
  clientName       String?
  raiderAccountId  String?
  expiresAt        DateTime
  approvedAt       DateTime?
  consumedAt       DateTime?
  createdAt        DateTime         @default(now())

  raiderAccount RaiderAccount?    @relation(fields: [raiderAccountId], references: [id], onDelete: SetNull)
  device        DeviceCredential?

  @@index([status, expiresAt])
  @@index([raiderAccountId])
}

model DeviceCredential {
  id              String    @id @default(cuid())
  name            String
  tokenHash       String    @unique
  linkRequestId   String?   @unique
  raiderAccountId String?
  createdAt       DateTime  @default(now())
  lastSeenAt      DateTime?
  revokedAt       DateTime?

  linkRequest   DeviceLinkRequest? @relation(fields: [linkRequestId], references: [id], onDelete: SetNull)
  raiderAccount RaiderAccount?     @relation(fields: [raiderAccountId], references: [id], onDelete: SetNull)

  @@index([revokedAt])
  @@index([raiderAccountId])
}
