generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Character {
  id           String    @id @default(cuid())
  battleNetId  String?
  name         String
  realm        String
  realmSlug    String?
  region       String    @default("eu")
  className    String
  level        Int       @default(80)
  source       String    @default("MANUAL")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  professions       CharacterProfession[]
  weeklyCompletions WeeklyChecklistCompletion[]
  weeklyMythicRuns  WeeklyMythicPlusRun[]
  personalRaidTasks PersonalRaidTask[]
  gearSlots         CharacterGearSlot[]
  trackerValues     CharacterTrackerValue[]
  tagAssignments    CharacterTagAssignment[]

  @@unique([name, realm, region])
  @@index([battleNetId, region])
  @@index([source])
}

model CharacterTag {
  id        String   @id @default(cuid())
  name      String   @unique
  color     String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments CharacterTagAssignment[]
}

model CharacterTagAssignment {
  id          String   @id @default(cuid())
  characterId String
  tagId       String
  createdAt   DateTime @default(now())

  character Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)
  tag       CharacterTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([characterId, tagId])
  @@index([tagId])
}

model WeeklyChecklistTask {
  id          String  @id @default(cuid())
  key         String  @unique
  title       String
  description String
  category    String
  sortOrder   Int     @default(0)
  enabled     Boolean @default(true)

  completions WeeklyChecklistCompletion[]
}

model WeeklyChecklistCompletion {
  id          String   @id @default(cuid())
  characterId String
  taskId      String
  periodKey   String
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  task      WeeklyChecklistTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([characterId, taskId, periodKey])
  @@index([periodKey])
  @@index([taskId, periodKey])
}

model WeeklyMythicPlusRun {
  id          String   @id @default(cuid())
  characterId String
  periodKey   String
  dungeonName String?
  keyLevel    Int
  completedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, periodKey])
  @@index([periodKey, keyLevel])
}

model PersonalRaidTask {
  id          String    @id @default(cuid())
  characterId String
  title       String
  description String?
  category    String    @default("PREPARATION")
  priority    String    @default("NORMAL")
  raidName    String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId, completedAt])
  @@index([dueAt])
}

model CharacterGearSlot {
  id            String    @id @default(cuid())
  characterId   String
  slotKey       String
  itemName      String
  itemLevel     Int?
  enchantStatus String    @default("NOT_APPLICABLE")
  enchantName   String?
  socketCount   Int       @default(0)
  gemCount      Int       @default(0)
  notes         String?
  source        String    @default("MANUAL")
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, slotKey])
  @@index([slotKey])
  @@index([source])
}

model TrackerScopeProfile {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  isActive  Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TrackerValueType {
  BOOLEAN
  PROGRESS
  NUMBER
  TEXT
}

enum TrackerResetBehavior {
  WEEKLY
  SEASONAL
  PERMANENT
}

model CharacterTrackerDefinition {
  id            String               @id @default(cuid())
  scopeKey      String
  key           String
  name          String
  valueType     TrackerValueType
  resetBehavior TrackerResetBehavior
  category      String?
  sortOrder     Int                  @default(0)
  isPinned      Boolean              @default(true)
  enabled       Boolean              @default(true)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  values CharacterTrackerValue[]

  @@unique([scopeKey, key])
  @@index([scopeKey])
  @@index([enabled, isPinned])
}

model CharacterTrackerValue {
  id                  String   @id @default(cuid())
  trackerDefinitionId String
  characterId         String
  periodKey           String

  booleanValue    Boolean?
  progressCurrent Int?
  progressTotal   Int?
  numberValue     Int?
  textValue       String?

  source    String   @default("MANUAL")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trackerDefinition CharacterTrackerDefinition @relation(fields: [trackerDefinitionId], references: [id], onDelete: Cascade)
  character         Character                  @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([trackerDefinitionId, characterId, periodKey])
  @@index([characterId])
  @@index([periodKey])
}

model Profession {
  id       String @id @default(cuid())
  key      String @unique
  name     String
  category String
  order    Int    @default(0)

  assignments         CharacterProfession[]
  specializationTrees ProfessionSpecializationTree[]
  capabilities        CraftCapability[]
  recipes             CraftRecipe[]
}

model CharacterProfession {
  id                    String  @id @default(cuid())
  characterId           String
  professionId          String
  skill                 Int     @default(0)
  skillModifier         Int     @default(0)
  knowledgePoints       Int     @default(0)
  specializationSummary String?

  character  Character  @relation(fields: [characterId], references: [id], onDelete: Cascade)
  profession Profession @relation(fields: [professionId], references: [id], onDelete: Cascade)

  nodeProgress CharacterProfessionNodeProgress[]
  recipes      CharacterCraftRecipe[]

  @@unique([characterId, professionId])
  @@index([professionId])
}

model ProfessionSpecializationTree {
  id           String  @id @default(cuid())
  professionId String
  expansion    String  @default("MIDNIGHT")
  key          String
  name         String
  description  String?
  sortOrder    Int     @default(0)

  profession Profession                     @relation(fields: [professionId], references: [id], onDelete: Cascade)
  nodes      ProfessionSpecializationNode[]

  @@unique([professionId, expansion, key])
  @@index([professionId, expansion])
}

model ProfessionSpecializationNode {
  id               String  @id @default(cuid())
  treeId           String
  parentNodeId     String?
  key              String
  name             String
  description      String?
  maxRank          Int?
  knowledgeMaxRank Int?
  spellId          Int?
  iconUrl          String?
  sortOrder        Int     @default(0)

  tree     ProfessionSpecializationTree      @relation(fields: [treeId], references: [id], onDelete: Cascade)
  parent   ProfessionSpecializationNode?     @relation("SpecializationNodeHierarchy", fields: [parentNodeId], references: [id], onDelete: SetNull)
  children ProfessionSpecializationNode[]    @relation("SpecializationNodeHierarchy")
  progress CharacterProfessionNodeProgress[]

  @@unique([treeId, key])
  @@index([treeId, parentNodeId])
}

model CharacterProfessionNodeProgress {
  id                    String    @id @default(cuid())
  characterProfessionId String
  nodeId                String
  rank                  Int       @default(1)
  knowledgeRank         Int?
  unlockRank            Int?
  source                String    @default("MANUAL")
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  characterProfession CharacterProfession          @relation(fields: [characterProfessionId], references: [id], onDelete: Cascade)
  node                ProfessionSpecializationNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([characterProfessionId, nodeId])
  @@index([nodeId])
  @@index([source])
}

model CraftCapability {
  id           String  @id @default(cuid())
  professionId String
  expansion    String  @default("MIDNIGHT")
  key          String
  name         String
  type         String
  slotKey      String?
  description  String?
  sortOrder    Int     @default(0)

  profession Profession              @relation(fields: [professionId], references: [id], onDelete: Cascade)
  recipes    CraftRecipeCapability[]

  @@unique([professionId, expansion, key])
  @@index([professionId, expansion])
  @@index([professionId, expansion, type])
}

model CraftRecipe {
  id                   String    @id @default(cuid())
  professionId         String
  gameRecipeId         Int
  skillLineId          Int?
  expansion            String    @default("MIDNIGHT")
  name                 String
  categoryId           Int?
  craftedItemId        Int?
  iconUrl              String?
  itemQuality          String?
  itemLevel            Int?
  baseDifficulty       Int?
  operationMetricsJson String?
  reagentSchemaJson    String?
  source               String    @default("ADDON")
  lastSyncedAt         DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  profession   Profession              @relation(fields: [professionId], references: [id], onDelete: Cascade)
  capabilities CraftRecipeCapability[]
  characters   CharacterCraftRecipe[]

  @@unique([professionId, gameRecipeId])
  @@index([professionId, expansion])
  @@index([gameRecipeId])
  @@index([craftedItemId])
}

model CraftRecipeCapability {
  craftRecipeId String
  capabilityId  String
  isPrimary     Boolean @default(false)

  recipe     CraftRecipe     @relation(fields: [craftRecipeId], references: [id], onDelete: Cascade)
  capability CraftCapability @relation(fields: [capabilityId], references: [id], onDelete: Cascade)

  @@id([craftRecipeId, capabilityId])
  @@index([capabilityId])
}

model CharacterCraftRecipe {
  id                          String    @id @default(cuid())
  characterProfessionId       String
  craftRecipeId               String
  learned                     Boolean   @default(true)
  baseSkill                   Int?
  bonusSkill                  Int?
  effectiveSkill              Int?
  craftingQuality             Int?
  craftingQualityId           Int?
  guaranteedCraftingQualityId Int?
  lowerSkillThreshold         Int?
  upperSkillThreshold         Int?
  concentrationCost           Int?
  concentrationCurrencyId     Int?
  ingenuityRefund             Int?
  quality                     Float?
  operationMetricsJson        String?
  reagentSimulationJson       String?
  operationCapturedAt         DateTime?
  operationCaptureVersion     Int?
  operationScopeVersion       Int?
  source                      String    @default("ADDON")
  lastSyncedAt                DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  characterProfession CharacterProfession @relation(fields: [characterProfessionId], references: [id], onDelete: Cascade)
  recipe              CraftRecipe         @relation(fields: [craftRecipeId], references: [id], onDelete: Cascade)

  @@unique([characterProfessionId, craftRecipeId])
  @@index([craftRecipeId])
  @@index([source])
  @@index([operationCaptureVersion])
}

model GuildMember {
  id           String    @id @default(cuid())
  name         String
  realm        String
  region       String    @default("eu")
  className    String
  level        Int       @default(80)
  rank         String
  rankIndex    Int       @default(0)
  role         String?
  note         String?
  officerNote  String?
  source       String    @default("MANUAL")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  averageItemLevel    Float?
  missingEnchantSlots Int?
  totalSocketCount    Int?
  filledSocketCount   Int?
  auditedAt           DateTime?

  linkedRaiderAccountId String? @unique

  teamMemberships GuildTeamMembership[]
  officerNotes    GuildOfficerNote[]
  gearSlots       GuildMemberGearSlot[]

  @@unique([name, realm, region])
  @@index([rankIndex])
  @@index([source])
}

model GuildMemberGearSlot {
  id                String   @id @default(cuid())
  memberId          String
  slotKey           String
  itemName          String?
  itemLevel         Int?
  quality           String?
  enchantStatus     String   @default("NOT_APPLICABLE")
  socketCount       Int      @default(0)
  filledSocketCount Int      @default(0)
  upgradeCurrent    Int?
  upgradeMax        Int?
  updatedAt         DateTime @updatedAt

  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, slotKey])
  @@index([memberId])
}

model GuildOfficerNote {
  id              String   @id @default(cuid())
  memberId        String
  authorCharacter String
  body            String
  createdAt       DateTime @default(now())

  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

model GuildTeam {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GuildTeamMembership[]
}

model GuildTeamMembership {
  id       String   @id @default(cuid())
  teamId   String
  memberId String
  role     String   @default("MEMBER")
  joinedAt DateTime @default(now())

  team   GuildTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member GuildMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, memberId])
  @@index([memberId])
}

model GuildRequirement {
  id               String   @id @default(cuid())
  title            String
  description      String?
  category         String   @default("OTHER")
  minimumItemLevel Int?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model LootTierPreference {
  id        String   @id @default(cuid())
  memberId  String
  tierSlot  String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, tierSlot])
  @@index([memberId])
}

model LootTrinketChoice {
  id        String   @id @default(cuid())
  memberId  String
  rank      Int
  itemId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([memberId, rank])
  @@index([memberId])
}

model LootSimReport {
  id           String   @id @default(cuid())
  memberId     String   @unique
  reportId     String
  reportUrl    String
  publicTitle  String
  charClass    String
  spec         String
  baselineDps  Float
  upgradesJson String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GuildVerification {
  id                  String   @id
  guildName           String
  realmName           String
  realmSlug           String
  region              String
  faction             String?
  memberCount         Int?
  verifiedCharacter   String
  verifiedRealmSlug   String
  verifiedRank        Int
  leadershipThreshold Int      @default(2)
  verifiedAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BattleNetOAuthState {
  id        String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model RaiderAccount {
  id             String    @id @default(cuid())
  battleTag      String?   @unique
  accessToken    String?
  tokenType      String?
  scope          String?
  tokenExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions RaiderSession[]
}

model RaiderSession {
  id              String   @id
  raiderAccountId String
  charactersJson  String
  expiresAt       DateTime
  createdAt       DateTime @default(now())

  account RaiderAccount @relation(fields: [raiderAccountId], references: [id], onDelete: Cascade)

  @@index([raiderAccountId])
}

enum DeviceLinkStatus {
  PENDING
  APPROVED
  CONSUMED
  EXPIRED
}

model DeviceLinkRequest {
  id             String           @id @default(cuid())
  userCode       String           @unique
  deviceCodeHash String           @unique
  status         DeviceLinkStatus @default(PENDING)
  clientName     String?
  expiresAt      DateTime
  approvedAt     DateTime?
  consumedAt     DateTime?
  createdAt      DateTime         @default(now())

  device DeviceCredential?

  @@index([status, expiresAt])
}

model DeviceCredential {
  id            String    @id @default(cuid())
  name          String
  tokenHash     String    @unique
  linkRequestId String?   @unique
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime?
  revokedAt     DateTime?

  linkRequest DeviceLinkRequest? @relation(fields: [linkRequestId], references: [id], onDelete: SetNull)

  @@index([revokedAt])
}
