PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=file:./prisma/dev.db
CRAFTING_MIN_LEVEL=80

BATTLENET_REGION=eu
BATTLENET_LOCALE=de_DE
BATTLENET_CLIENT_ID=
BATTLENET_CLIENT_SECRET=
BATTLENET_RAIDER_REDIRECT_URI=http://localhost:4000/api/auth/raider/callback

WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_CLIENT_SECRET=

# Phase G3B raw-ingest diagnostics DB - separate from DATABASE_URL/dev.db.
# Never a source of truth for product logic.
#
# INGEST_OBSERVATION_ENABLED accepts only true/1 or false/0. Leave it
# unset to get the environment-sensitive default: Development defaults
# ON for local debugging; Production defaults OFF and requires setting
# this to true explicitly to opt in. Set explicitly to override either
# default in any environment.
# INGEST_OBSERVATION_ENABLED=true
INGEST_OBSERVATION_DB_PATH=./prisma/ingest-observation.db

# Directory holding the built desktop-client installer(s) for the
# self-hosted download at /api/client-download - resolved relative to
# apps/api. Drop SynTrackClientSetup-<version>.exe here; never commit
# the actual installer file (see .gitignore).
CLIENT_DOWNLOAD_DIR=./public/client-downloads