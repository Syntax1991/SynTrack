<Window x:Class="SynTrack.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:SynTrack.Client.Infrastructure"
        Title="SynTrack" Width="1080" Height="700" MinWidth="920" MinHeight="580"
        Background="{StaticResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        ResizeMode="CanResize">
    <Window.Resources>
        <infra:ToneToBrushConverter x:Key="ToneToBrush" />
        <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
        <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <infra:ClassNameToColorConverter x:Key="ClassColor" />

        <Style x:Key="RosterColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderText}" />

        <Style x:Key="SidebarSeparator" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{StaticResource BorderBrush}" />
            <Setter Property="Margin" Value="0,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===================== Header ===================== -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentBrush}">
                        <TextBlock Text="S" FontSize="15" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="SynTrack" Style="{StaticResource TitleText}" />
                        <TextBlock Text="Personal Control Center" Style="{StaticResource MutedText}" FontSize="10" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ShowFullyConnectedIdentity, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0"
                             Fill="{Binding ConnectionStatusTone, Converter={StaticResource ToneToBrush}}" />
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold"
                               Text="{Binding BattleTag}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ShowReconnectRequired, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0"
                             Fill="{Binding ConnectionStatusTone, Converter={StaticResource ToneToBrush}}" />
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Reconnect required" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding ShowConnectionIssue, Converter={StaticResource BoolToVisibility}}">
                    <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0"
                             Fill="{Binding ConnectionStatusTone, Converter={StaticResource ToneToBrush}}" />
                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="Connection issue" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Signed-out state ===================== -->
        <StackPanel Grid.Row="1" Visibility="{Binding ShowSignedOutShell, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,60,0,0" HorizontalAlignment="Center">

            <Border Width="52" Height="52" CornerRadius="13" Background="{StaticResource AccentBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="S" FontSize="24" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="SynTrack" Style="{StaticResource TitleText}" FontSize="20"
                       Margin="0,16,0,4" HorizontalAlignment="Center" />

            <TextBlock Text="Connect your SynTrack account to sync your World of Warcraft characters."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="360" Margin="0,0,0,20" />

            <Button Content="Continue with Battle.net" Style="{StaticResource PrimaryButton}"
                    Command="{Binding ConnectCommand}" Padding="20,10" HorizontalAlignment="Center" />
            <TextBlock Text="Opens securely in your browser" Style="{StaticResource MutedText}"
                       Margin="0,10,0,0" HorizontalAlignment="Center" />

            <TextBlock Margin="0,16,0,0" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="360"
                       Text="{Binding ConnectError}"
                       Visibility="{Binding ConnectError, Converter={StaticResource NullToVisibility}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"
                        Visibility="{Binding ConnectError, Converter={StaticResource NullToVisibility}}">
                <Button Content="Try again" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ConnectCommand}" Margin="0,0,8,0" />
                <Button Content="Copy sign-in link" Style="{StaticResource GhostButton}"
                        Command="{Binding CopySignInLinkCommand}"
                        Visibility="{Binding SignInBrowserUrl, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </StackPanel>

        <!-- ===================== Connecting (codeless poll) ===================== -->
        <StackPanel Grid.Row="1" Visibility="{Binding ShowConnectingShell, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,60,0,0" HorizontalAlignment="Center">

            <TextBlock Text="Connecting to SynTrack" Style="{StaticResource TitleText}" FontSize="20"
                       HorizontalAlignment="Center" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0"
                         Fill="{Binding ConnectionStatusTone, Converter={StaticResource ToneToBrush}}" />
                <TextBlock Text="Waiting for Battle.net..." Style="{StaticResource BodyText}" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Text="Complete sign-in in your browser." Style="{StaticResource MutedText}"
                       Margin="0,6,0,16" HorizontalAlignment="Center" />

            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" TextAlignment="Center"
                       MaxWidth="360" Text="{Binding ConnectError}"
                       Visibility="{Binding ConnectError, Converter={StaticResource NullToVisibility}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelConnectCommand}" Margin="0,0,8,0" />
                <Button Content="Open browser again" Style="{StaticResource GhostButton}"
                        Command="{Binding OpenBrowserAgainCommand}" Margin="0,0,8,0" />
                <Button Content="Copy sign-in link" Style="{StaticResource GhostButton}"
                        Command="{Binding CopySignInLinkCommand}"
                        Visibility="{Binding SignInBrowserUrl, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>
        </StackPanel>

        <!-- ===================== Connected state: two-column layout ===================== -->
        <Grid Grid.Row="1" Visibility="{Binding ShowConnectedShell, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: operational sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,12,16,14">

                        <!-- CLIENT STATUS -->
                        <TextBlock Text="CLIENT STATUS" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0"
                                     Fill="{Binding ConnectionStatusTone, Converter={StaticResource ToneToBrush}}" />
                            <TextBlock Text="{Binding ConnectionStatusLabel}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Margin="15,4,0,0"
                                   Visibility="{Binding ShowFullyConnectedIdentity, Converter={StaticResource BoolToVisibility}}"
                                   Text="{Binding BattleTag, StringFormat='Connected as {0}'}"
                                   Style="{StaticResource BodyText}" />
                        <StackPanel Margin="15,4,0,0"
                                    Visibility="{Binding ShowReconnectRequired, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="This client credential is not linked to a SynTrack account. Reconnect with Battle.net once to bind ownership." />
                            <Button Content="Reconnect with Battle.net" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ReconnectCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" Padding="14,8" />
                        </StackPanel>
                        <StackPanel Margin="15,4,0,0"
                                    Visibility="{Binding ShowConnectionIssue, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                                       Text="Could not load account identity. Your credential is preserved — retry when SynTrack is reachable." />
                            <Button Content="Retry" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RetryProfileCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Content="Disconnect" Style="{StaticResource DangerGhostButton}"
                                Command="{Binding DisconnectCommand}" HorizontalAlignment="Left" Margin="12,8,0,0" />

                        <Border Style="{StaticResource SidebarSeparator}" />

                        <!-- ADDON / SYNC -->
                        <TextBlock Text="ADDON / SYNC" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0"
                                     Fill="{Binding WatcherStatusTone, Converter={StaticResource ToneToBrush}}" />
                            <TextBlock Text="{Binding WatcherStatusLabel}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0"
                                     Fill="{Binding SyncStatusTone, Converter={StaticResource ToneToBrush}}" />
                            <TextBlock Text="{Binding SyncStatusLabel}" Style="{StaticResource BodyText}" />
                        </StackPanel>
                        <TextBlock Margin="15,4,0,0" Style="{StaticResource MutedText}"
                                   Text="{Binding LastSyncAt, StringFormat='Last sync: {0:g}', TargetNullValue='Last sync: Never'}" />
                        <Button Content="Sync now" Style="{StaticResource SecondaryButton}"
                                Command="{Binding SyncNowCommand}" HorizontalAlignment="Left" Margin="12,8,0,0" />

                        <Border Style="{StaticResource SidebarSeparator}" />

                        <!-- WORLD OF WARCRAFT -->
                        <TextBlock Text="WORLD OF WARCRAFT" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />

                        <StackPanel Visibility="{Binding WowPath, Converter={StaticResource NullToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0" Fill="{StaticResource SuccessBrush}" />
                                <TextBlock Text="{Binding WowDetectionLabel}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding WowPath}" Style="{StaticResource MutedText}" Margin="15,4,0,8" TextWrapping="Wrap" />
                            <Button Content="Change installation..." Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                                    Margin="12,0,0,0" Command="{Binding BrowseWowCommand}" />
                        </StackPanel>

                        <StackPanel Visibility="{Binding WowPath, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,7,0" Fill="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding WowDetectionLabel}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="15,8,0,0">
                                <Button Content="Detect" Style="{StaticResource SecondaryButton}" Command="{Binding DetectWowCommand}" Margin="0,0,8,0" />
                                <Button Content="Browse..." Style="{StaticResource SecondaryButton}" Command="{Binding BrowseWowCommand}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="WoW Account" Style="{StaticResource MutedText}" Margin="0,12,0,4" />
                        <ComboBox ItemsSource="{Binding AccountCandidates}"
                                  DisplayMemberPath="AccountName" SelectedValuePath="AccountName"
                                  SelectedValue="{Binding AccountName}" />

                        <Border Style="{StaticResource SidebarSeparator}" />

                        <!-- SETTINGS -->
                        <TextBlock Text="SETTINGS" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,8" />
                        <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Margin="0,0,0,8" />
                        <CheckBox Content="Start with Windows" IsChecked="{Binding Autostart}" />

                        <Border Style="{StaticResource SidebarSeparator}" />

                        <Button Content="Open SynTrack" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenSynTrackCommand}" HorizontalAlignment="Left" Margin="12,0,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- RIGHT: character roster -->
            <Grid Grid.Column="1" Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="CHARACTERS" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,12" />

                <Grid Grid.Row="1" Margin="12,0,12,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="0.8*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="0.7*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CHARACTER" Style="{StaticResource RosterColumnHeader}" />
                    <TextBlock Grid.Column="1" Text="REALM" Style="{StaticResource RosterColumnHeader}" />
                    <TextBlock Grid.Column="2" Text="ILVL" Style="{StaticResource RosterColumnHeader}" />
                    <TextBlock Grid.Column="3" Text="LAST SYNC" Style="{StaticResource RosterColumnHeader}" />
                    <TextBlock Grid.Column="4" Text="STATUS" Style="{StaticResource RosterColumnHeader}" />
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{StaticResource BorderBrush}"
                        VerticalAlignment="Bottom" Margin="12,0,12,0" />

                <Grid Grid.Row="2">
                    <TextBlock Text="Loading characters..." Style="{StaticResource MutedText}"
                               HorizontalAlignment="Left" Margin="12,14,0,0"
                               Visibility="{Binding IsLoadingCharacters, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="440"
                               HorizontalAlignment="Left" Margin="12,14,0,0"
                               Text="{Binding CharactersError}"
                               Visibility="{Binding CharactersError, Converter={StaticResource NullToVisibility}}" />

                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="440"
                               HorizontalAlignment="Left" Margin="12,14,0,0"
                               Text="Reconnect with Battle.net to load your account-scoped character roster."
                               Visibility="{Binding ShowRosterOwnershipBlocked, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" MaxWidth="440"
                               HorizontalAlignment="Left" Margin="12,14,0,0"
                               Text="No synced characters yet. Log into World of Warcraft and SynTrack will capture them automatically."
                               Visibility="{Binding ShowEmptyRosterMessage, Converter={StaticResource BoolToVisibility}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Characters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                                        <Grid Height="38" Margin="12,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2.2*" />
                                                <ColumnDefinition Width="1.4*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="0.7*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" FontSize="12"
                                                       Foreground="{Binding ClassName, Converter={StaticResource ClassColor}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Realm}" Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding ItemLevelLabel}" Style="{StaticResource BodyText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding LastSyncLabel}" Style="{StaticResource MutedText}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyText}">
                                                        <Setter Property="Text" Value="—" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSyncedData}" Value="True">
                                                                <Setter Property="Text" Value="✓" />
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
