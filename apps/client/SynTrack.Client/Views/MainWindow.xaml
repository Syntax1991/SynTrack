<Window x:Class="SynTrack.Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:SynTrack.Client.Infrastructure"
        Title="SynTrack Client" Height="480" Width="360"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <infra:ToneToBrushConverter x:Key="ToneToBrush" />
        <infra:BoolToConnectionLabelConverter x:Key="ConnectionLabel" />
        <infra:NullToVisibilityConverter x:Key="NullToVisibility" />
        <infra:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <TabControl Margin="8">
        <TabItem Header="Status">
            <StackPanel Margin="8">
                <TextBlock Text="SynTrack" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />

                <GroupBox Header="Connection" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock Text="{Binding Connected, Converter={StaticResource ConnectionLabel}}" />

                        <TextBlock Margin="0,4,0,0"
                                   Visibility="{Binding PendingUserCode, Converter={StaticResource NullToVisibility}}"
                                   Text="{Binding PendingUserCode, StringFormat='Approve code {0} in the browser tab that just opened.'}"
                                   TextWrapping="Wrap" />

                        <Button Margin="0,6,0,0" HorizontalAlignment="Left"
                                Content="Connect to SynTrack"
                                Command="{Binding ConnectCommand}"
                                Visibility="{Binding Connected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                        <Button Margin="0,6,0,0" HorizontalAlignment="Left"
                                Content="Disconnect"
                                Command="{Binding DisconnectCommand}"
                                Visibility="{Binding Connected, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="World of Warcraft" Margin="0,0,0,8">
                    <StackPanel Margin="6">
                        <TextBlock Text="{Binding WowPath, TargetNullValue='No install found yet.'}" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Detect" Command="{Binding DetectWowCommand}" Margin="0,0,6,0" />
                            <Button Content="Browse..." Command="{Binding BrowseWowCommand}" />
                        </StackPanel>

                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold" Text="WoW Account" />
                        <ComboBox Margin="0,4,0,0" ItemsSource="{Binding AccountCandidates}"
                                  DisplayMemberPath="AccountName" SelectedValuePath="AccountName"
                                  SelectedValue="{Binding AccountName}" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Sync">
                    <StackPanel Margin="6">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,6,0"
                                     Fill="{Binding SyncStatusTone, Converter={StaticResource ToneToBrush}}" />
                            <TextBlock Text="{Binding SyncStatusLabel}" />
                        </StackPanel>

                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding LastSyncAt, StringFormat='Last sync: {0:g}', TargetNullValue='Last sync: Never'}" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Sync now" Command="{Binding SyncNowCommand}" Margin="0,0,6,0" />
                            <Button Content="Open SynTrack" Command="{Binding OpenSynTrackCommand}" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </TabItem>

        <TabItem Header="Settings">
            <StackPanel Margin="8">
                <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Margin="0,4,0,4" />
                <CheckBox Content="Start with Windows" IsChecked="{Binding Autostart}" Margin="0,4,0,4" />
            </StackPanel>
        </TabItem>
    </TabControl>
</Window>
